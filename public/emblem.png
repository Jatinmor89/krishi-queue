<svg width="256" height="256" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f3d24"/>
      <stop offset="100%" stop-color="#062815"/>
    </linearGradient>
    <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f6b93b"/>
      <stop offset="100%" stop-color="#e0952a"/>
    </linearGradient>
    <linearGradient id="wheatGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffd873"/>
      <stop offset="100%" stop-color="#f0a93a"/>
    </linearGradient>
  </defs>

  <!-- Rounded square background -->
  <rect x="4" y="4" width="248" height="248" rx="56" fill="url(#bgGrad)"/>
  <rect x="4" y="4" width="248" height="248" rx="56" fill="none" stroke="#1a5c37" stroke-width="2"/>

  <!-- Dotted ring -->
  <circle cx="128" cy="128" r="92" fill="none" stroke="url(#ringGrad)" stroke-width="4" stroke-dasharray="3 7" stroke-linecap="round"/>

  <!-- Inner circle -->
  <circle cx="128" cy="128" r="78" fill="none" stroke="url(#ringGrad)" stroke-width="3"/>

  <!-- Central wheat / grain emblem -->
  <g transform="translate(128,128)">
    <!-- Central stalk -->
    <line x1="0" y1="46" x2="0" y2="-44" stroke="url(#wheatGrad)" stroke-width="4" stroke-linecap="round"/>

    <!-- Grain leaves - left side -->
    <g fill="url(#wheatGrad)">
      <ellipse cx="-16" cy="-30" rx="8" ry="15" transform="rotate(-35 -16 -30)"/>
      <ellipse cx="-19" cy="-12" rx="8" ry="15" transform="rotate(-35 -19 -12)"/>
      <ellipse cx="-19" cy="6" rx="8" ry="15" transform="rotate(-35 -19 6)"/>
      <ellipse cx="-16" cy="24" rx="8" ry="15" transform="rotate(-35 -16 24)"/>
    </g>

    <!-- Grain leaves - right side -->
    <g fill="url(#wheatGrad)">
      <ellipse cx="16" cy="-30" rx="8" ry="15" transform="rotate(35 16 -30)"/>
      <ellipse cx="19" cy="-12" rx="8" ry="15" transform="rotate(35 19 -12)"/>
      <ellipse cx="19" cy="6" rx="8" ry="15" transform="rotate(35 19 6)"/>
      <ellipse cx="16" cy="24" rx="8" ry="15" transform="rotate(35 16 24)"/>
    </g>

    <!-- Top bud -->
    <circle cx="0" cy="-46" r="7" fill="url(#wheatGrad)"/>

    <!-- Base leaves (small sprout wings at bottom) -->
    <path d="M0,46 C-14,50 -22,42 -24,32 C-12,32 -4,38 0,46 Z" fill="url(#wheatGrad)"/>
    <path d="M0,46 C14,50 22,42 24,32 C12,32 4,38 0,46 Z" fill="url(#wheatGrad)"/>
  </g>
</svg>
